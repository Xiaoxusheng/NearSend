{
  "name": "nearsend-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "局域网快传前端（React + TypeScript + Vite + Ant Design）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false"
  },
  "dependencies": {
    "@ant-design/icons": "latest",
    "antd": "latest",
    "dayjs": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
